{
  "name": "worktrace-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "compodoc": "compodoc -p tsconfig.app.json -s -r 8085 -o",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.10.0",
  "overrides": {
    "undici": "^7.24.5",
    "vite": "^7.3.2",
    "picomatch": "^4.0.4"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.6",
    "@angular/common": "^21.2.8",
    "@angular/compiler": "^21.2.8",
    "@angular/core": "^21.2.8",
    "@angular/forms": "^21.2.8",
    "@angular/material": "^21.2.6",
    "@angular/platform-browser": "^21.2.8",
    "@angular/router": "^21.2.8",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.8",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@compodoc/compodoc": "^1.1.16",
    "@eslint/js": "^10.0.1",
    "@types/date-fns": "^2.5.3",
    "@types/leaflet": "^1.9.21",
    "angular-eslint": "21.3.1",
    "eslint": "^10.0.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1"
  }
}